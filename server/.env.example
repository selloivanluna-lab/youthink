# YouTube extraction attempt control (affects timeouts)
# Maximum attempts per client (with/without cookies). Default: 5 -> 10 total attempts
YT_MAX_ATTEMPTS=5
# Per-attempt timeout in ms (min 5s). Default: 45000 (45s)
YT_ATTEMPT_MS=45000
# Global total timeout in ms (min 10s). Default: 100000 (100s total max wait)
YT_TOTAL_MS=100000
